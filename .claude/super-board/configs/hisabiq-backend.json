{
  "version": 1,
  "description": "HisabIQ greenfield backend; owner-approved merges",
  "project": {
    "owner": "shuvodelux-commits",
    "title": "HisabIQ Backend",
    "number": 1
  },
  "worker_backend": "workflow",
  "host": "codex",
  "model_tier": "medium",
  "target": {
    "type": "repo",
    "url": null
  },
  "repo": {
    "path": ".",
    "remote": "https://github.com/shuvodelux-commits/hisabiq-backend"
  },
  "base_branch": "main",
  "timezone": "Asia/Dhaka",
  "columns": [
    "Backlog",
    "Ready",
    "Building",
    "QA",
    "Review",
    "Blocked",
    "Done"
  ],
  "labels": [
    "qa",
    "bug",
    "feature"
  ],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": true,
  "merge_policy": {
    "default": "human",
    "auto_max_lines": 400,
    "allow_auto_on_production": false
  },
  "migrations": {
    "globs": [
      "**/migrations/*.sql",
      "drizzle/**"
    ],
    "allowed_envs": [],
    "target_env": "test",
    "commands": {},
    "checks": {},
    "human_steps": []
  },
  "max_workers": 1,
  "no_progress_cycles": 6,
  "rebuild_cap": 2,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "verify_commands": [
    "pnpm install --frozen-lockfile",
    "pnpm typecheck",
    "pnpm test"
  ],
  "collect": {
    "sources": [
      "github"
    ],
    "window_days": 14,
    "custom": []
  },
  "notifications": {
    "channel": "session",
    "bot_identity": "shuvodelux-commits"
  }
}
